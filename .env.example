# ── KONEK AI · local environment ─────────────────────────────────────
# Placeholders. Fill in real values to switch each service from mock to live.
# This file is gitignored. See README_BACKEND.md for setup.

# Supabase — database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role

# Twilio — outbound calls
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Voice + transcription
CARTESIA_API_KEY=your_cartesia_key
DEEPGRAM_API_KEY=your_deepgram_key

# Billing
STRIPE_SECRET_KEY=your_stripe_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_pub

# Embeddings for the Business Brain
OPENAI_API_KEY=your_openai_key

# REQUIRED before real calls can be placed. Any long random string.
# While Twilio is configured, /api/call rejects requests without this key.
KONEK_API_SECRET=

# Public base URL, used for Twilio webhooks and Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
