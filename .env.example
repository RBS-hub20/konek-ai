# ── KONEK AI · local environment ─────────────────────────────────────
# Placeholders. Fill in real values to switch each service from mock to live.
# This file is gitignored. See README_BACKEND.md for setup.

# Supabase — database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role

# Twilio — outbound calls
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Voice + transcription
CARTESIA_API_KEY=your_cartesia_key
DEEPGRAM_API_KEY=your_deepgram_key

# Billing
STRIPE_SECRET_KEY=your_stripe_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_pub

# Embeddings for the Business Brain
OPENAI_API_KEY=your_openai_key

# REQUIRED before real calls can be placed. Any long random string.
# While Twilio is configured, /api/call rejects requests without this key.
KONEK_API_SECRET=

# Public base URL, used for Twilio webhooks and Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Media bridge (two-way conversation) ─────────────────────────────
# Twilio connects to this websocket; the browser never does.
# Any of these forms work — https is converted to wss and /media-stream added:
#   https://konek-ai-production.up.railway.app
#   wss://konek-ai-production.up.railway.app/media-stream
# Precedence: MEDIA_STREAM_URL > NEXT_PUBLIC_BRIDGE_URL > BRIDGE_URL > built-in default.
MEDIA_STREAM_URL=wss://konek-ai-production.up.railway.app/media-stream
NEXT_PUBLIC_BRIDGE_URL=https://konek-ai-production.up.railway.app

# ── Super admin console ─────────────────────────────────────────────
# Guards /super-admin and its APIs. Without this the documented default
# (KonekSuper2025!) applies, which is in the repository and protects nobody.
SUPER_ADMIN_PASSWORD=
