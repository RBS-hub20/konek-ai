# Required — the same OpenAI key the Vercel app uses
OPENAI_API_KEY=sk-...

# Required so the bridge can read each tenant's prompt from the app
KONEK_API_SECRET=<same value as in Vercel>
KONEK_APP_URL=https://konek-ai.vercel.app

# Optional
OPENAI_REALTIME_MODEL=gpt-realtime
MAX_CALL_SECONDS=600
LOG_LEVEL=info
PORT=8080

# ── Text to speech ──────────────────────────────────────────────────
# 'cartesia' routes the model's text through Sonic; 'openai' (default) keeps
# the realtime speech-to-speech voice.
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=sk_car_...

# Optional. The voice is looked up by name at boot; set an id to pin it.
CARTESIA_MODEL=sonic-2
CARTESIA_VOICE_NAME=Skylar
# CARTESIA_VOICE_ID=
# CARTESIA_SPEED=slow        # only sent when set
# CARTESIA_VERSION=2024-06-10
